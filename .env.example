# ---- Copy this file to ".env" and fill in your values. ----

APP_NAME=VoteHub
PORT=3000
# Address people use to reach the site (used in emails and Paystack redirects)
PUBLIC_URL=http://localhost:3000

# PostgreSQL on your computer. Replace YOUR_PASSWORD with the password you chose when installing PostgreSQL.
# The "votehub" database is created automatically on first start if it doesn't exist.
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/votehub

# Long random secret (32+ chars). Encrypts payment keys & signs voter sessions.
# Never change it after going live, or saved Paystack keys can't be decrypted.
APP_SECRET=

# Emails that automatically become platform super-admins (comma separated).
# (The very first account created is always a super-admin.)
PLATFORM_ADMIN_EMAILS=

# Email (voter invitations, verification codes, password resets).
# Without SMTP, emails are printed in the server window instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="VoteHub <no-reply@example.com>"

# The platform's own Paystack account (or enter it in Super admin -> Plans & settings).
# Collects subscriptions (and renews them automatically) and event passes. Organizations add their own
# gateways (Paystack, Flutterwave, Stripe, Monnify, OPay) or manual bank-transfer methods in their settings.
PAYSTACK_SECRET_KEY=

# SMS invitations & reminders via Termii (https://termii.com). Without these, SMS text is printed in the server window.
TERMII_API_KEY=
TERMII_SENDER_ID=
# TERMII_CHANNEL=generic

# Simulated "test" payments are always available in development. Set true to allow them in production too.
ALLOW_TEST_PAYMENTS=false
